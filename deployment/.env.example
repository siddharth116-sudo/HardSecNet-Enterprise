# Copy to deployment/.env and fill in real values before `docker compose up`.
# docker compose reads this file automatically from the deployment/ directory.
#
# Generate strong secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Your public address -----------------------------------------------
# The domain name pointing at this server (no https://, no trailing slash).
# Caddy uses it to fetch a free HTTPS certificate automatically.
DOMAIN=hardsecnet.duckdns.org

# --- Database credentials ----------------------------------------------
# MongoDB root user, created on first boot (required — Mongo refuses
# unauthenticated connections). Any long random password works.
MONGO_USER=hardsecnet
MONGO_PASSWORD=change-me-strong-password

# --- Application secrets ------------------------------------------------
# Signs login tokens (required — no insecure fallback). MUST be long and
# random — generate one, don't invent one.
JWT_SECRET_KEY=

# Encrypts remote-node WinRM passwords at rest (optional; falls back to JWT_SECRET_KEY)
NODE_SECRET_KEY=

# First-boot password for the 'admin' dashboard user. You log in with this
# once, then change it from the dashboard.
BOOTSTRAP_ADMIN_PASSWORD=

# Shared key every agent must present (X-Agent-Key). On a public server,
# ALWAYS set this — otherwise anyone on the internet can submit fake reports.
AGENT_API_KEY=
