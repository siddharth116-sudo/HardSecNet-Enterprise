# ─────────────────────────────────────────────────────────────────────────────
# HardSecNet Backend Configuration
# Copy this file to .env and fill in real values before running the server.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Flask runtime mode: development | production
FLASK_ENV=development
FLASK_APP=app.py
PORT=5000
HOST=0.0.0.0
# Local dev: run plain HTTP on :5000 so the Vite frontend can connect.
# Leave false (or unset) in production to use HTTPS/mTLS when certs are present.
HSN_DEV_HTTP=true
# Verbose Flask errors (dev only — never enable in production)
FLASK_DEBUG=0

# ── Security Secrets (CHANGE THESE IN PROD!) ─────────────────────────────────
# JWT_SECRET_KEY is REQUIRED — the app refuses to start without it (no fallback).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ACCESS_TOKEN_EXPIRES_HOURS=1
# Encrypts remote-node WinRM passwords at rest in MongoDB. Optional: falls back to
# JWT_SECRET_KEY if unset. Set a dedicated value and rotate independently in prod.
NODE_SECRET_KEY=

# ── Initial admin bootstrap (first run only) ─────────────────────────────────
# If BOOTSTRAP_ADMIN_PASSWORD is blank, a random one-time password is printed once.
# The admin must change it on first login.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=
MIN_PASSWORD_LENGTH=12
# Lab only: seed weak demo accounts (secops/auditor/viewer). Never enable in prod.
SEED_DEMO_USERS=false

# ── Agent Authentication ─────────────────────────────────────────────────────
# Shared key host agents must present (X-Agent-Key) to POST audit reports.
# Leave blank to accept unauthenticated reports (dev only). See agent/README.md.
AGENT_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/
DB_NAME=hardsecnet

# ── Cache / Task Queue / Rate-limit storage ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * to allow all (dev only).
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:8443

# ── Socket.IO async mode ─────────────────────────────────────────────────────
# threading = Werkzeug dev server (supports ssl_context, good for local dev)
# eventlet  = used by Gunicorn in Docker production
SOCKETIO_ASYNC_MODE=threading

# ── Feature Flags ────────────────────────────────────────────────────────────
# AUTO_REMEDIATE_DEFAULT: if true the server auto-hardens on drift detection
AUTO_REMEDIATE_DEFAULT=False
# Score (%) below which drift is flagged (0–100)
DRIFT_THRESHOLD=80

# ── AI remediation engine ────────────────────────────────────────────────────
# HSN_AI_MODE: off = deterministic explanations only (no model calls),
#              local = Ollama, claude = Anthropic API. Falls back to deterministic
#              automatically if the chosen model is unreachable.
HSN_AI_MODE=off
HSN_AI_TIMEOUT=6
# Local (Ollama) provider
HSN_OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/generate
HSN_OLLAMA_MODEL=phi3
# Hosted (Claude) provider — required only when HSN_AI_MODE=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
